{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Parent Studio design tokens 1.0.0 — Soft Harbor. Light values are $value; dark values are in $extensions['studio.modes']. Aliases use {path.to.token}.",
  "color": {
    "primitive": {
      "$description": "Raw colours. Never used directly in a product; semantic tokens alias them.",
      "harbor-mist": { "$value": "#F4F6F7", "$type": "color", "$description": "Light canvas. Soft coastal grey." },
      "white": { "$value": "#FFFFFF", "$type": "color", "$description": "Light raised surface." },
      "still": { "$value": "#E9EFF2", "$type": "color", "$description": "Light sunken / secondary surface." },
      "driftwood": { "$value": "#D8DFE4", "$type": "color", "$description": "Light decorative line. Never a field boundary." },
      "harbor-ink": { "$value": "#1E2A33", "$type": "color", "$description": "Light primary text. Deep desaturated teal-slate." },
      "harbor-slate": { "$value": "#5B6F7B", "$type": "color", "$description": "Light secondary text." },
      "harbor-blue": { "$value": "#5B7A8C", "$type": "color", "$description": "The one accent. Fills and graphics only — never body text." },
      "harbor-blue-deep": { "$value": "#486575", "$type": "color", "$description": "Pressed / hover state of the accent fill." },
      "harbor-blue-ink": { "$value": "#3E5C6B", "$type": "color", "$description": "The text-grade accent. 6.57:1 on light canvas." },
      "warm-sand": { "$value": "#F1ECE4", "$type": "color", "$description": "Warm alternate surface. Sparing use only." },
      "fog-line": { "$value": "#768893", "$type": "color", "$description": "Light field boundary. 3.39:1 on canvas." },
      "abyss": { "$value": "#131D25", "$type": "color", "$description": "Dark canvas." },
      "deep": { "$value": "#1B2833", "$type": "color", "$description": "Dark raised surface." },
      "trench": { "$value": "#243443", "$type": "color", "$description": "Dark sunken / secondary surface." },
      "reef": { "$value": "#2F414F", "$type": "color", "$description": "Dark decorative line." },
      "foam": { "$value": "#E9EFF3", "$type": "color", "$description": "Dark primary text." },
      "spray": { "$value": "#9AADBA", "$type": "color", "$description": "Dark secondary text. 7.37:1 on canvas." },
      "gull": { "$value": "#82A5B6", "$type": "color", "$description": "Dark accent. 6.51:1 on canvas — text-safe." },
      "gull-lift": { "$value": "#96B7C7", "$type": "color", "$description": "Dark hover state of the accent fill." },
      "tide-line": { "$value": "#546B7A", "$type": "color", "$description": "Dark field boundary. 3.06:1 on canvas." },
      "sea-glass": { "$value": "#3E7C5B", "$type": "color", "$description": "Success, light." },
      "sea-glass-bright": { "$value": "#6FAE8A", "$type": "color", "$description": "Success, dark. 6.58:1 on canvas." },
      "buoy": { "$value": "#B4543F", "$type": "color", "$description": "Alert, light." },
      "buoy-bright": { "$value": "#D08675", "$type": "color", "$description": "Alert, dark. 5.97:1 on canvas." },
      "lantern": { "$value": "#4E7A8C", "$type": "color", "$description": "Verify, light." },
      "lantern-bright": { "$value": "#7A9DAD", "$type": "color", "$description": "Verify, dark. 5.90:1 on canvas." }
    },
    "semantic": {
      "$description": "What a product uses. $value is light; dark is in studio.modes.",
      "surface": {
        "canvas": { "$value": "{color.primitive.harbor-mist}", "$type": "color", "$description": "The page.", "$extensions": { "studio.modes": { "dark": "{color.primitive.abyss}" } } },
        "primary": { "$value": "{color.primitive.white}", "$type": "color", "$description": "Cards, panels.", "$extensions": { "studio.modes": { "dark": "{color.primitive.deep}" } } },
        "secondary": { "$value": "{color.primitive.still}", "$type": "color", "$description": "Sunken panels, input wells, table bodies.", "$extensions": { "studio.modes": { "dark": "{color.primitive.trench}" } } },
        "overlay": { "$value": "{color.primitive.white}", "$type": "color", "$description": "Dialogs, sheets.", "$extensions": { "studio.modes": { "dark": "{color.primitive.deep}" } } },
        "input": { "$value": "{color.primitive.white}", "$type": "color", "$description": "A field at rest.", "$extensions": { "studio.modes": { "dark": "{color.primitive.trench}" } } },
        "inverse": { "$value": "{color.primitive.harbor-ink}", "$type": "color", "$description": "Tooltips, dark slabs on light.", "$extensions": { "studio.modes": { "dark": "{color.primitive.foam}" } } },
        "warm": { "$value": "{color.primitive.warm-sand}", "$type": "color", "$description": "Alternate band. One per page, max.", "$extensions": { "studio.modes": { "dark": "{color.primitive.trench}" } } },
        "scrim": { "$value": "rgb(30 42 51 / 0.45)", "$type": "color", "$description": "Behind a dialog.", "$extensions": { "studio.modes": { "dark": "rgb(0 0 0 / 0.55)" } } }
      },
      "text": {
        "primary": { "$value": "{color.primitive.harbor-ink}", "$type": "color", "$description": "13.51:1 on light canvas.", "$extensions": { "studio.modes": { "dark": "{color.primitive.foam}" } } },
        "secondary": { "$value": "{color.primitive.harbor-slate}", "$type": "color", "$description": "4.84:1 on light canvas. Never on warm-sand except large text.", "$extensions": { "studio.modes": { "dark": "{color.primitive.spray}" } } },
        "accent": { "$value": "{color.primitive.harbor-blue-ink}", "$type": "color", "$description": "The only blue allowed as text. 6.57:1 on light canvas.", "$extensions": { "studio.modes": { "dark": "{color.primitive.gull}" } } },
        "inverse": { "$value": "{color.primitive.white}", "$type": "color", "$description": "On inverse surfaces and accent fills.", "$extensions": { "studio.modes": { "dark": "{color.primitive.abyss}" } } },
        "placeholder": { "$value": "{color.primitive.harbor-slate}", "$type": "color", "$description": "At 0.7 opacity. Placeholder is never the accessible name.", "$extensions": { "studio.modes": { "dark": "{color.primitive.spray}" } } },
        "link": { "$value": "{color.primitive.harbor-blue-ink}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.primitive.gull}" } } }
      },
      "accent": {
        "fill": { "$value": "{color.primitive.harbor-blue}", "$type": "color", "$description": "Primary buttons, selected states, marks. White label is 4.56:1.", "$extensions": { "studio.modes": { "dark": "{color.primitive.gull}" } } },
        "hover": { "$value": "{color.primitive.harbor-blue-deep}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.primitive.gull-lift}" } } },
        "active": { "$value": "#3E5C6B", "$type": "color", "$description": "Pressed fill, light.", "$extensions": { "studio.modes": { "dark": "#B9D2DE" } } },
        "soft": { "$value": "rgba(91, 122, 140, 0.10)", "$type": "color", "$description": "Selected rows, soft highlights, light.", "$extensions": { "studio.modes": { "dark": "rgba(130, 165, 182, 0.14)" } } },
        "ring": { "$value": "{color.primitive.harbor-blue}", "$type": "color", "$description": "The focus ring. 4.20:1 light / 6.51:1 dark as a graphic.", "$extensions": { "studio.modes": { "dark": "{color.primitive.gull}" } } }
      },
      "line": {
        "hairline": { "$value": "{color.primitive.driftwood}", "$type": "color", "$description": "Decorative dividers only. 1.24:1 — never carries meaning alone.", "$extensions": { "studio.modes": { "dark": "{color.primitive.reef}" } } },
        "boundary": { "$value": "{color.primitive.fog-line}", "$type": "color", "$description": "Field and control borders. 3.39:1 light / 3.06:1 dark.", "$extensions": { "studio.modes": { "dark": "{color.primitive.tide-line}" } } },
        "selected": { "$value": "{color.semantic.accent.fill}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.semantic.accent.fill}" } } }
      },
      "interaction": {
        "hover": { "$value": "rgb(30 42 51 / 0.04)", "$type": "color", "$description": "Hovered row or item.", "$extensions": { "studio.modes": { "dark": "rgb(233 239 243 / 0.06)" } } },
        "pressed": { "$value": "rgb(30 42 51 / 0.08)", "$type": "color", "$extensions": { "studio.modes": { "dark": "rgb(233 239 243 / 0.10)" } } },
        "selected": { "$value": "{color.semantic.accent.soft}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.semantic.accent.soft}" } } },
        "disabled-opacity": { "$value": 0.45, "$type": "number", "$description": "Disabled controls keep colour at 45%." }
      },
      "feedback": {
        "success": {
          "solid": { "$value": "{color.primitive.sea-glass}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.primitive.sea-glass-bright}" } } },
          "on-solid": { "$value": "#FFFFFF", "$type": "color", "$description": "4.96:1 on light solid.", "$extensions": { "studio.modes": { "dark": "{color.primitive.abyss}" } } },
          "text": { "$value": "{color.primitive.sea-glass}", "$type": "color", "$description": "4.57:1 on light canvas. Use on tinted bg in badges.", "$extensions": { "studio.modes": { "dark": "{color.primitive.sea-glass-bright}" } } },
          "bg": { "$value": "color-mix(in srgb, {color.primitive.sea-glass} 12%, transparent)", "$type": "color", "$extensions": { "studio.modes": { "dark": "color-mix(in srgb, {color.primitive.sea-glass-bright} 16%, transparent)" } } },
          "border": { "$value": "color-mix(in srgb, {color.primitive.sea-glass} 38%, transparent)", "$type": "color", "$extensions": { "studio.modes": { "dark": "color-mix(in srgb, {color.primitive.sea-glass-bright} 40%, transparent)" } } }
        },
        "alert": {
          "solid": { "$value": "{color.primitive.buoy}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.primitive.buoy-bright}" } } },
          "on-solid": { "$value": "#FFFFFF", "$type": "color", "$description": "4.90:1 on light solid.", "$extensions": { "studio.modes": { "dark": "{color.primitive.abyss}" } } },
          "text": { "$value": "{color.primitive.buoy}", "$type": "color", "$description": "4.53:1 on light canvas. Use on tinted bg in badges.", "$extensions": { "studio.modes": { "dark": "{color.primitive.buoy-bright}" } } },
          "bg": { "$value": "color-mix(in srgb, {color.primitive.buoy} 12%, transparent)", "$type": "color", "$extensions": { "studio.modes": { "dark": "color-mix(in srgb, {color.primitive.buoy-bright} 16%, transparent)" } } },
          "border": { "$value": "color-mix(in srgb, {color.primitive.buoy} 38%, transparent)", "$type": "color", "$extensions": { "studio.modes": { "dark": "color-mix(in srgb, {color.primitive.buoy-bright} 40%, transparent)" } } }
        },
        "info": {
          "text": { "$value": "{color.primitive.harbor-blue-ink}", "$type": "color", "$description": "Info reuses the accent hue. 6.57:1 light / 6.51:1 dark.", "$extensions": { "studio.modes": { "dark": "{color.primitive.gull}" } } },
          "bg": { "$value": "{color.semantic.accent.soft}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.semantic.accent.soft}" } } },
          "border": { "$value": "color-mix(in srgb, {color.primitive.harbor-blue} 38%, transparent)", "$type": "color", "$extensions": { "studio.modes": { "dark": "color-mix(in srgb, {color.primitive.gull} 40%, transparent)" } } }
        },
        "verify": {
          "text": { "$value": "{color.primitive.harbor-blue-ink}", "$type": "color", "$description": "Verify text uses the text-grade accent in light (6.57:1); lantern-bright in dark (5.90:1).", "$extensions": { "studio.modes": { "dark": "{color.primitive.lantern-bright}" } } },
          "solid": { "$value": "{color.primitive.lantern}", "$type": "color", "$description": "Solid badges and icons only — not body text (4.32:1).", "$extensions": { "studio.modes": { "dark": "{color.primitive.lantern-bright}" } } },
          "bg": { "$value": "color-mix(in srgb, {color.primitive.lantern} 12%, transparent)", "$type": "color", "$extensions": { "studio.modes": { "dark": "color-mix(in srgb, {color.primitive.lantern-bright} 16%, transparent)" } } },
          "border": { "$value": "color-mix(in srgb, {color.primitive.lantern} 38%, transparent)", "$type": "color", "$extensions": { "studio.modes": { "dark": "color-mix(in srgb, {color.primitive.lantern-bright} 40%, transparent)" } } }
        }
      },
      "chart": {
        "$description": "Fixed order for dashboards and reports.",
        "1": { "$value": "{color.primitive.harbor-blue}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.primitive.gull}" } } },
        "2": { "$value": "{color.primitive.sea-glass}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.primitive.sea-glass-bright}" } } },
        "3": { "$value": "{color.primitive.buoy}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.primitive.buoy-bright}" } } },
        "4": { "$value": "{color.primitive.lantern}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.primitive.lantern-bright}" } } },
        "5": { "$value": "{color.primitive.harbor-slate}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.primitive.spray}" } } },
        "grid": { "$value": "{color.semantic.line.hairline}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.semantic.line.hairline}" } } },
        "axis-text": { "$value": "{color.semantic.text.secondary}", "$type": "color", "$extensions": { "studio.modes": { "dark": "{color.semantic.text.secondary}" } } }
      }
    }
  },
  "font": {
    "family": {
      "display": { "$value": ["Fraunces", "Georgia", "serif"], "$type": "fontFamily", "$description": "Headlines and numerals. Variable wght 400–700, optical sizing on." },
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"], "$type": "fontFamily", "$description": "Body, UI, buttons." },
      "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "Menlo", "monospace"], "$type": "fontFamily", "$description": "Kickers, labels, code, IDs." },
      "urdu": { "$value": ["Noto Nastaliq Urdu", "Noto Naskh Arabic", "serif"], "$type": "fontFamily", "$description": "Urdu: Nastaliq for headings and body, Naskh for dense tables." }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight", "$description": "Headings, emphasis. No 700 in UI text." },
      "display": { "$value": 600, "$type": "fontWeight", "$description": "Fraunces headlines." },
      "display-tight": { "$value": 700, "$type": "fontWeight", "$description": "Numerals and the wordmark only." }
    },
    "size": {
      "display-l": { "$value": "clamp(2.5rem, 5.6vw, 6rem)", "$type": "dimension", "$description": "40 → 96px. The hero." },
      "display-m": { "$value": "clamp(2rem, 4.2vw, 4.5rem)", "$type": "dimension", "$description": "32 → 72px. Section titles." },
      "display-s": { "$value": "clamp(1.5rem, 2.6vw, 2.25rem)", "$type": "dimension", "$description": "24 → 36px. h3-level display." },
      "h1": { "$value": "clamp(1.875rem, 2.4vw, 2.25rem)", "$type": "dimension", "$description": "30 → 36px. App page title." },
      "h2": { "$value": "1.5rem", "$type": "dimension", "$description": "24px." },
      "h3": { "$value": "1.25rem", "$type": "dimension", "$description": "20px." },
      "h4": { "$value": "1.0625rem", "$type": "dimension", "$description": "17px." },
      "h5": { "$value": "0.9375rem", "$type": "dimension", "$description": "15px." },
      "h6": { "$value": "0.75rem", "$type": "dimension", "$description": "12px, mono, uppercase." },
      "body-l": { "$value": "clamp(1.0625rem, 1.3vw, 1.25rem)", "$type": "dimension", "$description": "17 → 20px. The lead." },
      "body": { "$value": "clamp(0.9375rem, 1.05vw, 1.0625rem)", "$type": "dimension", "$description": "15 → 17px." },
      "body-s": { "$value": "0.8125rem", "$type": "dimension", "$description": "13px." },
      "caption": { "$value": "0.75rem", "$type": "dimension", "$description": "12px." },
      "overline": { "$value": "0.75rem", "$type": "dimension", "$description": "12px mono kicker." },
      "code": { "$value": "0.875rem", "$type": "dimension", "$description": "14px." },
      "badge": { "$value": "0.6875rem", "$type": "dimension", "$description": "11px." },
      "numeric": { "$value": "clamp(1.75rem, 3vw, 3rem)", "$type": "dimension", "$description": "28 → 48px. Stat numerals." },
      "button": { "$value": "0.9375rem", "$type": "dimension", "$description": "15px." },
      "nav": { "$value": "0.9375rem", "$type": "dimension", "$description": "15px." }
    },
    "line-height": {
      "display": { "$value": 1.0, "$type": "number" },
      "tight": { "$value": 1.15, "$type": "number" },
      "snug": { "$value": 1.3, "$type": "number" },
      "lead": { "$value": 1.5, "$type": "number" },
      "body": { "$value": 1.6, "$type": "number" },
      "single": { "$value": 1, "$type": "number" }
    },
    "letter-spacing": {
      "display": { "$value": "-0.02em", "$type": "dimension" },
      "body": { "$value": "0", "$type": "dimension" },
      "button": { "$value": "-0.01em", "$type": "dimension" },
      "mono": { "$value": "0.1em", "$type": "dimension", "$description": "Uppercase mono labels." }
    }
  },
  "typography": {
    "$description": "Composite roles: font, size, line-height, weight, tracking.",
    "display-l": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.display-l}", "fontWeight": "{font.weight.display}", "lineHeight": "{font.line-height.display}", "letterSpacing": "{font.letter-spacing.display}" }, "$type": "typography" },
    "display-m": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.display-m}", "fontWeight": "{font.weight.display}", "lineHeight": "{font.line-height.display}", "letterSpacing": "{font.letter-spacing.display}" }, "$type": "typography" },
    "display-s": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.display-s}", "fontWeight": "{font.weight.display}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.display}" }, "$type": "typography" },
    "h1": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.h1}", "fontWeight": "{font.weight.display}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.display}" }, "$type": "typography" },
    "h2": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.h2}", "fontWeight": "{font.weight.display}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.display}" }, "$type": "typography" },
    "h3": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.h3}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.body}" }, "$type": "typography" },
    "h4": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.h4}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.body}" }, "$type": "typography" },
    "h5": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.h5}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.body}" }, "$type": "typography" },
    "h6": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.h6}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.single}", "letterSpacing": "{font.letter-spacing.mono}" }, "$type": "typography", "$description": "Uppercase." },
    "body-l": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.body-l}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.lead}", "letterSpacing": "{font.letter-spacing.body}" }, "$type": "typography" },
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.body}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.body}", "letterSpacing": "{font.letter-spacing.body}" }, "$type": "typography" },
    "body-s": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.body-s}", "fontWeight": "{font.weight.regular}", "lineHeight": "1.5", "letterSpacing": "{font.letter-spacing.body}" }, "$type": "typography" },
    "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.caption}", "fontWeight": "{font.weight.regular}", "lineHeight": "1.4", "letterSpacing": "{font.letter-spacing.body}" }, "$type": "typography" },
    "overline": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.overline}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.single}", "letterSpacing": "{font.letter-spacing.mono}" }, "$type": "typography", "$description": "Uppercase. The kicker." },
    "code": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.code}", "fontWeight": "{font.weight.regular}", "lineHeight": "1.55", "letterSpacing": "{font.letter-spacing.body}" }, "$type": "typography" },
    "badge": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.badge}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.single}", "letterSpacing": "{font.letter-spacing.mono}" }, "$type": "typography", "$description": "Uppercase." },
    "numeric": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.numeric}", "fontWeight": "{font.weight.display-tight}", "lineHeight": "{font.line-height.single}", "letterSpacing": "{font.letter-spacing.display}" }, "$type": "typography", "$description": "Tabular figures." },
    "button": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.button}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.single}", "letterSpacing": "{font.letter-spacing.button}" }, "$type": "typography" }
  },
  "space": {
    "$description": "4px base. Names are multiples of 4.",
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" },
    "32": { "$value": "128px", "$type": "dimension" },
    "section": { "$value": "clamp(80px, 10vw, 160px)", "$type": "dimension", "$description": "Between marketing sections. Generous by design." },
    "gutter": { "$value": "clamp(20px, 4vw, 56px)", "$type": "dimension", "$description": "The page gutter." }
  },
  "radius": {
    "xs": { "$value": "6px", "$type": "dimension", "$description": "Checkboxes, small chips." },
    "sm": { "$value": "10px", "$type": "dimension", "$description": "Buttons, inputs, small cards." },
    "md": { "$value": "14px", "$type": "dimension", "$description": "Cards." },
    "lg": { "$value": "20px", "$type": "dimension", "$description": "Dialogs, popovers, large cards." },
    "xl": { "$value": "28px", "$type": "dimension", "$description": "Sheets, hero media." },
    "pill": { "$value": "9999px", "$type": "dimension", "$description": "Badges and toggle pills only — not buttons." }
  },
  "border": {
    "hairline": { "$value": { "width": "1px", "style": "solid", "color": "{color.semantic.line.hairline}" }, "$type": "border", "$description": "Decorative dividers." },
    "boundary": { "$value": { "width": "1px", "style": "solid", "color": "{color.semantic.line.boundary}" }, "$type": "border", "$description": "Fields and controls at rest." },
    "selected": { "$value": { "width": "2px", "style": "solid", "color": "{color.semantic.line.selected}" }, "$type": "border", "$description": "Selected cards and rows." },
    "invalid": { "$value": { "width": "2px", "style": "solid", "color": "{color.semantic.feedback.alert.solid}" }, "$type": "border" },
    "focus": { "$value": { "width": "2px", "style": "solid", "color": "{color.semantic.accent.ring}" }, "$type": "border", "$description": "Outline with 2px offset, :focus-visible only." }
  },
  "shadow": {
    "$description": "Subtle, tinted to harbor ink. Cards rest on borders, not shadows.",
    "rest": { "$value": "none", "$type": "shadow", "$description": "Default card state. Flat." },
    "lift": {
      "$value": [{ "color": "rgb(30 42 51 / 0.12)", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-8px" }],
      "$type": "shadow", "$description": "Hovered or draggable card.",
      "$extensions": { "studio.modes": { "dark": [{ "color": "rgb(0 0 0 / 0.40)", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-8px" }] } }
    },
    "overlay": {
      "$value": [{ "color": "rgb(30 42 51 / 0.18)", "offsetX": "0px", "offsetY": "24px", "blur": "64px", "spread": "-16px" }],
      "$type": "shadow", "$description": "Dialogs, popovers, sheets.",
      "$extensions": { "studio.modes": { "dark": [{ "color": "rgb(0 0 0 / 0.55)", "offsetX": "0px", "offsetY": "24px", "blur": "64px", "spread": "-16px" }] } }
    },
    "pressed": {
      "$value": [{ "color": "rgb(30 42 51 / 0.10)", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px", "inset": true }],
      "$type": "shadow", "$description": "Pressed segment or switch.",
      "$extensions": { "studio.modes": { "dark": [{ "color": "rgb(0 0 0 / 0.35)", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px", "inset": true }] } }
    }
  },
  "blur": {
    "nav": { "$value": "12px", "$type": "dimension", "$description": "Sticky nav backdrop, with 80% canvas fill." }
  },
  "opacity": {
    "disabled": { "$value": 0.45, "$type": "number" },
    "scrim": { "$value": 0.5, "$type": "number" },
    "skeleton-lo": { "$value": 0.35, "$type": "number" },
    "skeleton-hi": { "$value": 0.75, "$type": "number" }
  },
  "z-index": {
    "base": { "$value": 0, "$type": "number" },
    "raised": { "$value": 1, "$type": "number" },
    "sticky": { "$value": 10, "$type": "number" },
    "dropdown": { "$value": 30, "$type": "number" },
    "header": { "$value": 40, "$type": "number" },
    "sheet": { "$value": 50, "$type": "number" },
    "overlay": { "$value": 60, "$type": "number" },
    "toast": { "$value": 70, "$type": "number" },
    "modal": { "$value": 80, "$type": "number" },
    "preloader": { "$value": 100, "$type": "number" }
  },
  "breakpoint": {
    "sm": { "$value": "640px", "$type": "dimension" },
    "md": { "$value": "768px", "$type": "dimension" },
    "lg": { "$value": "1024px", "$type": "dimension" },
    "xl": { "$value": "1280px", "$type": "dimension" },
    "2xl": { "$value": "1536px", "$type": "dimension" }
  },
  "layout": {
    "page-max": { "$value": "1200px", "$type": "dimension", "$description": "Content column." },
    "prose-max": { "$value": "68ch", "$type": "dimension" },
    "nav-h": { "$value": "68px", "$type": "dimension" },
    "touch-min": { "$value": "44px", "$type": "dimension", "$description": "Minimum touch target." },
    "form-col": { "$value": "560px", "$type": "dimension" },
    "dialog-max": { "$value": "480px", "$type": "dimension" },
    "drawer-w": { "$value": "420px", "$type": "dimension" },
    "sidebar-w": { "$value": "264px", "$type": "dimension" },
    "sidebar-rail-w": { "$value": "64px", "$type": "dimension" }
  },
  "duration": {
    "$description": "ms. Calm by design — shorter and softer than a marketing-heavy brand.",
    "instant": { "$value": "80ms", "$type": "duration", "$description": "Knobs, checks, carets." },
    "fast": { "$value": "150ms", "$type": "duration", "$description": "Hover colour and opacity; small exits." },
    "base": { "$value": "250ms", "$type": "duration", "$description": "Toggles, menus, popovers, dialogs, toasts. Travel ≤ 64px." },
    "slow": { "$value": "400ms", "$type": "duration", "$description": "Button colour; header return." },
    "page": { "$value": "600ms", "$type": "duration", "$description": "Route crossfade." },
    "reveal": { "$value": "800ms", "$type": "duration", "$description": "In-view reveals. Marketing only." },
    "stagger": { "$value": "60ms", "$type": "duration", "$description": "Sibling stagger, cap 8 items." },
    "tooltip-delay": { "$value": "300ms", "$type": "duration" },
    "toast-hold": { "$value": "5000ms", "$type": "duration" }
  },
  "easing": {
    "$description": "Soft curves. Nothing snaps or bounces.",
    "out": { "$value": [0.22, 1, 0.36, 1], "$type": "cubicBezier", "$description": "The house curve. Enters, reveals, hover transforms." },
    "in-out": { "$value": [0.65, 0, 0.35, 1], "$type": "cubicBezier", "$description": "Things that open and later close: toggles, accordions." },
    "in": { "$value": [0.55, 0, 1, 0.45], "$type": "cubicBezier", "$description": "Exits." },
    "linear": { "$value": [0, 0, 1, 1], "$type": "cubicBezier", "$description": "Progress bars, marquee, scrubbed tweens only." }
  },
  "transition": {
    "$description": "Composite: duration + timingFunction. Which component uses which is in foundations/motion.md.",
    "hover-color": { "$value": { "duration": "{duration.fast}", "timingFunction": "{easing.out}", "delay": "0ms" }, "$type": "transition" },
    "button-color": { "$value": { "duration": "{duration.slow}", "timingFunction": "{easing.out}", "delay": "0ms" }, "$type": "transition" },
    "press": { "$value": { "duration": "{duration.fast}", "timingFunction": "{easing.out}", "delay": "0ms" }, "$type": "transition", "$description": "Button transform on press." },
    "toggle": { "$value": { "duration": "{duration.base}", "timingFunction": "{easing.in-out}", "delay": "0ms" }, "$type": "transition" },
    "menu-open": { "$value": { "duration": "{duration.base}", "timingFunction": "{easing.out}", "delay": "0ms" }, "$type": "transition" },
    "menu-close": { "$value": { "duration": "{duration.fast}", "timingFunction": "{easing.in}", "delay": "0ms" }, "$type": "transition" },
    "dialog-in": { "$value": { "duration": "{duration.base}", "timingFunction": "{easing.out}", "delay": "0ms" }, "$type": "transition" },
    "dialog-out": { "$value": { "duration": "{duration.fast}", "timingFunction": "{easing.in}", "delay": "0ms" }, "$type": "transition" },
    "toast-in": { "$value": { "duration": "{duration.base}", "timingFunction": "{easing.out}", "delay": "0ms" }, "$type": "transition" },
    "reveal": { "$value": { "duration": "{duration.reveal}", "timingFunction": "{easing.out}", "delay": "0ms" }, "$type": "transition" },
    "route": { "$value": { "duration": "{duration.page}", "timingFunction": "{easing.out}", "delay": "0ms" }, "$type": "transition" }
  },
  "travel": {
    "sm": { "$value": "8px", "$type": "dimension", "$description": "Small enter travel." },
    "lg": { "$value": "20px", "$type": "dimension", "$description": "Reveal travel." }
  }
